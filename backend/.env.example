NODE_ENV=production
PORT=5000

# MongoDB Atlas SRV connection string. Replace <password> with the Atlas DB user password.
MONGO_URI=mongodb+srv://amirlatif2288_db_user:<password>@cluster0.ljm4hc2.mongodb.net/mdcat_lms?retryWrites=true&w=majority&appName=Cluster0

# Use a long random value in production. Do not commit the real value.
JWT_SECRET=replace-with-a-64-character-random-secret
JWT_EXPIRE=7d

# Comma-separated frontend origins allowed to call the API.
# Add your final Vercel production domain after Vercel deploys.
CORS_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app

# Google Identity Services client ID used by frontend and backend token verification.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Keep false in production. Only true for local debugging without email delivery.
ALLOW_DEBUG_OTP=false

# SMTP option. Gmail requires an App Password, not your normal Gmail password.
SMTP_SERVICE=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="MDCAT LMS <no-reply@mdcat-lms.com>"
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000

# Recommended production email option if SMTP ports are blocked by the host.
RESEND_API_KEY=
RESEND_TIMEOUT_MS=10000

# Alternative production email option.
BREVO_API_KEY=
BREVO_TIMEOUT_MS=10000

# ==================== DEPLOYMENT / RESILIENCE ====================

# Free-text label shown by GET /api/health/db. Use it to confirm which backend a
# domain is actually hitting when more than one deployment exists.
DEPLOYMENT_TARGET=hostinger

# Number of reverse proxies in front of Node, or true/false.
# Hostinger (LiteSpeed/Passenger) = 1. Getting this wrong makes every visitor
# look like the same IP, which collapses rate limiting into one shared bucket.
TRUST_PROXY=1

# Only ONE deployment may run the notification scheduler, or the same job is
# claimed and emailed twice. Set to false on every other deployment.
ENABLE_SCHEDULER=true

# Mongo connection tuning. The default 20s server-selection timeout tolerates a
# cold start on shared hosting; the old 5s value gave up too early.
MONGO_SERVER_SELECTION_TIMEOUT_MS=20000
MONGO_POOL_SIZE=10

# Building indexes on every boot slows cold starts and can stall the first
# requests. Keep false in production and run `npm run sync-indexes` after any
# schema change instead.
MONGO_AUTO_INDEX=false

# One-off legacy role migration. It scans the whole users collection with no
# index, so it must not run on every production boot.
RUN_LEGACY_ROLE_MIGRATION=false
